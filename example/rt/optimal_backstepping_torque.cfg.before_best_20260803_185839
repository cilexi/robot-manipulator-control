# xCore 6 轴实物机械臂：最优反步/SARL 力矩控制参数
#
# 格式：key = value；数组必须有 6 个数，依次对应关节 1~6。
# 角度单位 rad，速度 rad/s，加速度 rad/s^2，力矩 Nm。
# 修改本文件后无需重新编译；CPP 启动时逐行读取，并拒绝未知键、非数值和
# 长度不是 6 的逐轴数组。注释从 # 开始，可在参数前后自由增加。
#
# 【相对原参考 negotiable_ppc_torque.cpp/.cfg 的主要改动】
# 1) 删除原控制器的 negotiable PPC、人机交互力和 Y0/URDF 动力学回归参数；
# 2) 新增论文的输出状态约束变换 z1、两步最优反步 alpha/z2/tau；
# 3) 新增 core-function 鲁棒项 nu_r、hat_vartheta 自适应；
# 4) 新增两层 actor-critic、Bellman 残差和 pseudo-Huber 学习方向缩放；
# 5) 本专用版本把受控集合固定为物理关节 4、5、6，并同步降阶网络与 M_AA；
# 6) 保留 MoveJ、1 kHz 力矩回调，并增加双重解锁、变化率/幅值/状态保护。
#
# 【论文符号到 CFG 的快速索引】
# z1/alpha：output_bound、barrier_b0/bf、k1、actor_limit1
# z2/tau：k2、iota、use_xmate_cr7_urdf_mass_matrix、actor_limit2
# Q_i/R_i：q1_cost、r1_cost、q2_cost、r2_cost
# hat_vartheta：theta_initial、gamma_theta、sigma_theta、theta_max
# pseudo-Huber：gamma_c/a*、weight_gain_*、delta_*、pseudo_huber_eps*

# -----------------------------------------------------------------------------
# 0. 直接上机排查版：硬件解锁
# -----------------------------------------------------------------------------
# 真机运行必须同时：
#   1) 把下面两项都改成 true；
#   2) 用命令行 --run 启动；
#   3) 已核对 IP、准备位姿、关节 1~3 的外部固定、力矩限值和急停。
# hardware_enable 与 ready_pose_confirmed 是 CFG 内的第二层确认；命令行
# --run 是第一层。仅运行程序或仅把一项改为 true 都不会连接机械臂。
hardware_enable = true
ready_pose_confirmed = true
# false：不执行 MoveJ，直接使用启动时的当前姿态作为 q_init（本排查版默认）。
# true：执行 MoveJ 到 ready_q；只有 ready_q 已通过示教确认后才允许打开。
perform_ready_move = true
# true：无论正常结束或异常清理都尽力下电；false：退出时不主动下电。
power_off_on_exit = true
# robot_ip 是控制柜/机器人地址；local_ip 必须是连接实时网络的本机网卡地址。
robot_ip = 192.168.2.200
local_ip = 192.168.2.100

# -----------------------------------------------------------------------------
# 1. 实时循环与准备运动（参考轨迹相关参数）
# -----------------------------------------------------------------------------
# total_time：进入 1 kHz 力矩模式后的总时长；到时 SDK command.setFinished()。
# 慢速梯形参考在 15 s 完成回落，随后保留 5 s 低位观察/收紧段。
total_time = 20.0
# start_delay：控制器开始后保持 q_d=q_init 的时间，用于观察静止状态。
start_delay = 1.0
# trajectory_ramp_time：参考轨迹半余弦渐入时间；不改变后续稳态频率。
trajectory_ramp_time = 2.0
# command_ramp_time：对最终 tau_raw 再做半余弦渐入，属于真机保护而非论文项。
command_ramp_time = 2.0
# ready_move_speed：进入力矩模式前，SDK MoveJ 到 ready_q 的速度系数。
ready_move_speed = 0.05
# SDK 自带力矩滤波截止频率，必须位于 SDK 接受范围；它会给闭环引入相位滞后。
sdk_filter_cutoff_hz = 30.0

# [关节选择已固化]
# 本 CPP 只控制物理关节 4、5、6，不再读取 active_mask。这样网络输入维数、
# 三行输出权重和质量子矩阵在编译期保持一致，避免运行时改 mask 后网络含义
# 随之变化。关节 1、2、3 的命令恒为 0 Nm，必须由独立位置伺服、制动器或
# 机械约束固定；inactive_joints_fixed=true 是这一实验条件的强制声明。

# MoveJ 准备位姿。本排查版 perform_ready_move=false，因此不会运动到此零位。
# 后续若要打开 perform_ready_move，必须先把这里改成示教确认过的安全姿态。
ready_q = 0 0 0 0 0 0

# 以下 4 行是“备用单正弦模式”。仅当
# use_slow_trapezoid_reference=false 时才使用：
# qd = q_init + ramp * [offset + amp*sin(omega*t + phase)]。
# 关节 1~3 的 offset/amp 必须为 0，避免“不给力矩却要求跟踪”的矛盾。
traj_offset = 0 0 0 0 0 0
# 排查版连备用正弦模式也保持静止，防止误把 use_slow_trapezoid_reference
# 改为 false 后突然产生关节运动。
traj_amp = 0 0 0 0 0.02 0
traj_omega = 0 0 0 0 0.15 0
traj_phase = 0 0 0 0 0 0

# [当前实物参考：与仿真同形但更慢、更小]
# true：low -> 平滑抬升 -> high 平台 -> 平滑回落 -> low；
# false：使用上面的备用单正弦。所有时刻均从进入力矩模式开始计时。
use_slow_trapezoid_reference = false
# 完整20秒上机时序：0~4 s 为低位/准备段，4~8 s 平滑抬升，
# 8~11 s 为高位平台，11~15 s 平滑回落，15~20 s 为回落后观察段。
# start_delay+trajectory_ramp_time=3.0 <= 4.0，且上升/下降均为4秒，
# 因此满足CPP的连续性、时间顺序和等腰梯形检查。
slow_ref_rise_start = 4.0
slow_ref_rise_end = 8.0
slow_ref_fall_start = 11.0
slow_ref_fall_end = 15.0
# 所有数组是“相对本次 q_init 的角位移”，不是绝对关节角。
# low(t)  = base + low_amp*cos(2*pi*t/low_period)
# high(t) = base + lift + high_ripple_amp*cos(2*pi*t/high_period)
# qd-q_init=(1-g)*low+g*high，g 是上述 raised-cosine 梯形包络。
# CPP 同步解析计算 qd、dqd、ddqd，不做数值差分。
#
# 数组依次对应物理关节 1~6。本项目只控制 4、5、6，所以前 3 项必须为 0。
# 当前最坏位移保守上界分别约 0.054、0.046、0.038 rad；真机前仍应先空载、
# 低力矩限幅测试，并确认安装姿态下不会碰撞。
slow_ref_base = 0 0 0 0 0 0
slow_ref_low_amp = 0 0 0 0 0.007 0
slow_ref_lift = 0 0 0 0 -0.030 0
slow_ref_high_ripple_amp = 0 0 0 0 -0.005 0
# 周期越大，低位/高位小幅余弦变化越慢；单位 s。
slow_ref_low_period = 12.0
slow_ref_high_period = 26.0

# -----------------------------------------------------------------------------
# 2. 输出约束变换
# -----------------------------------------------------------------------------
# true：使用论文 eq:eta_zeta_x、eq:sx_definition，将物理角 q 映射为 s_x，
# 并以 z1=s_x(q)-s_x(q_d) 进入反步；false：直接令 z1=q-q_d。
# 这替换了原参考 negotiable PPC 的性能函数/人机协商约束，不再读取外力。
enable_output_barrier = true

# false：始终采用有限约束 beta=barrier_bf；true：启用下列时变约束。
# kappa=0 为约束阶段，kappa=1 为自由阶段。本实验轨迹配置为 C-F-C，
# 使 4~15 s 的大工作点变化完整落在自由阶段；第一次真机调试仍可先改回
# false，确认固定有限约束下能稳定跟踪后再做论文对比。
enable_constraint_schedule = true
# true：论文的自由->约束 F-C；false：保留约束->自由->约束 C-F-C。
# F-C 只读取 free_to_constraint 两个时刻；C-F-C 要求下面四个时刻递增。
constraint_schedule_start_free = false
# 完整20秒 C-F-C 时序：3~4 s 约束->自由；4~15 s 的慢速梯形变化
# 完整位于自由阶段；15~16 s 自由->约束；16~20 s 在收紧约束下观察。
constraint_to_free_start = 3.0
constraint_to_free_end = 4.0
free_to_constraint_start = 15.0
free_to_constraint_end = 16.0

# 约束中心 = 实时控制开始时 q_init + constraint_center_offset。
# 这是无机械臂模型条件下的工程坐标选择；offset=0 表示围绕本次实验的
# 实际起点建立约束，而不是围绕绝对零位。不得用它代替厂家软件/机械限位。
constraint_center_offset = 0 0 0 0 0 0

# 有限阶段要求 |q - constraint_center| < output_bound。
# 这些是实验边界而非机械臂厂家轴限位，必须比厂家限位更保守。
# CPP 会根据 output_bound、b0、bf 反算论文变换的 lambda：
# lambda=output_bound*sqrt(b0^2-bf^2)/bf，所以通常直接调 output_bound 即可。
output_bound = 0.20 0.20 0.20 0.15 0.15 0.12
# b0>bf>0。bf 定义有限阶段，b0 与变换尺度/自由阶段上界相关；不要把
# b0/bf 当成物理 rad，它们是无量纲决策边界参数。
barrier_b0 = 2.0
barrier_bf = 1.0
# 实时监视论文 zeta=eta/beta 的未钳位值；|zeta| 超过本比例立即发 0 Nm
# 并结束回调。必须严格在 (0,1)，应留出传感、离散和制动余量。
barrier_abort_ratio = 0.90

# -----------------------------------------------------------------------------
# 3. 两步最优反步控制器
# -----------------------------------------------------------------------------
# k1、k2 是 K1/K2 的逐轴对角元，实际 Pi_i=K_i+varrho_i I：
# alpha = Hx^{-1}(-Pi1*z1-h_beta+s_dot_d-actor1)
# v     = alpha_dot-Pi2*z2-Hx*z1-nu_r-actor2，且 z2=dq-alpha。
# 增大它们通常增强纠偏也会提高速度/力矩需求，必须配合限幅和低速递增。
k1 = 0 0 0 0 8.0 0
k2 = 0 0 0 0 12.0 0
# 论文 Pi_i=K_i+varrho_i I，varrho_i 是严格大于 0 的标量吸收增益。
# 论文实验段没有给出其数值；此处 1.0 是待通过离线仿真冻结的工程初值。
varrho1 = 1.0
varrho2 = 1.0
# q1/q2、r1/r2 分别是两层 HJB 即时代价中的逐轴 Q_i、R_i：
# e_i 包含 q_i*z_i^2+r_i*u_i^2+J_i_hat*a_i。它们主要影响 Bellman 残差、
# critic/actor 学习目标；在 enable_rl=false 时不会直接等价成普通 PD 增益。
q1_cost = 0 0 0 4.0 4.0 4.0
q2_cost = 0 0 0 0.5 0.5 0.5
r1_cost = 0 0 0 0.10 0.10 0.10
r2_cost = 0 0 0 0.02 0.02 0.02

# 以下三项是连续论文公式外的真机数值保护：alpha 是期望关节速度，
# alpha_dot 是其脏微分，virtual_accel 是映射为力矩前的 v。若日志中长期
# 贴住限幅，说明实际闭环已明显偏离理论律，应先降轨迹/增益并分析，而不
# 应简单继续放大上限。
alpha_limit = 0 0 0 0 0.08 0
alpha_dot_limit = 0 0 0 0 0.30 0
virtual_accel_limit = 0 0 0 0 0.40 0

# alpha_dot 的一阶“脏微分”滤波系数，范围 (0,1]；越小越平滑但滞后更大。
# 这是为了实现论文 tau 中的 alpha_dot 而新增；原参考 Y0 路径不使用该量。
alpha_dot_filter = 0.01

# -----------------------------------------------------------------------------
# 4. 未知动力学鲁棒自适应项
# -----------------------------------------------------------------------------
# 对应论文 eq:robust_output：
# nu_r = hat_vartheta * phi(q,dq)^2 * z2 / (2*iota^2)。iota 越小鲁棒项越强，
# 但也更容易产生大力矩；必须大于 0，真机不应在未复核时激进减小。
iota = 1.0
# hat_vartheta 初值；没有机械臂模型时它用于在线估计未知动力学包络强度。
theta_initial = 0.05
# false：hat_vartheta 固定在初值；true：learning_start_time 后按下式更新。
enable_theta_adaptation = false
# 对应 eq:vartheta_update_output 的自适应增益 gamma 与 sigma 修正泄漏：
# theta_dot = gamma_theta*phi^2*||z2_active||^2/(2*iota^2)-sigma_theta*theta。
gamma_theta = 0.02
sigma_theta = 0.10
# 数值投影上界（同时投影到非负），是实物保护而非未知参数的真实物理上界。
theta_max = 5.0

# -----------------------------------------------------------------------------
# 5. Actor-Critic 与 pseudo-Huber 在线学习
# -----------------------------------------------------------------------------
# 原参考 PPC 没有本节，全部参数均为论文 SARL 控制器新增。
# 第一阶段建议：先 false/false 跑通基线，再打开 enable_rl，最后打开在线学习。
# enable_rl=false：actor/critic 输出都按 0 处理；enable_rl=true 且
# enable_learning=false：使用初始/已加载权重但冻结；两项都 true 才在线更新。
enable_rl = false
enable_learning = false
# 鲁棒参数更新和网络学习共同延迟到该时刻后开始，先让轨迹/力矩平滑接入。
learning_start_time = 5.0

# 输出空间基准方向增益，对应论文 dc0/da0 中 gamma_ci、gamma_ai；后缀 1/2
# 表示反步层。数组仍按六轴写，前三项为 0，后三项对应关节 4~6。
gamma_c1 = 0 0 0 0.15 0.15 0.15
gamma_a1 = 0 0 0 0.18 0.18 0.18
gamma_c2 = 0 0 0 0.12 0.12 0.12
gamma_a2 = 0 0 0 0.15 0.15 0.15

# weight_gain_c/a 对应权重更新矩阵 Gamma_ci/Gamma_ai 的当前标量实现，
# 乘在 1 ms Euler 更新外层；增大可能加快学习，也更易产生离散振荡。
weight_gain_c1 = 0.20
weight_gain_a1 = 0.20
weight_gain_c2 = 0.15
weight_gain_a2 = 0.15
# leak_c/a 对应论文 ell_ci/ell_ai 权重泄漏，抑制无持续激励时权重漂移。
leak_c1 = 0.03
leak_a1 = 0.03
leak_c2 = 0.03
leak_a2 = 0.03
# delta_norm：Sbar=S/(S^T S+delta_norm) 的正则项（eq:Sbar_def）；
# delta_ci：Omega_ci=(Lambda*Lambda^T+delta_ci*I)^(-1) 的正则项。
# 第二层 Lambda 随完整 M_AA 非对角耦合，CPP 用 Cholesky 求解而不显式求逆。
delta_norm = 0.08
delta_ci = 0.08
# 对应论文 epsilon_g1/epsilon_g2：
# sigma_g=1/sqrt(1+epsilon_g^2*||[Bellman残差;e_P]||^2)，与仿真及论文
# 式(59)一致。值越大，异常残差越早被压缩；设 0 时 sigma_g=1。
pseudo_huber_eps1 = 0.04
pseudo_huber_eps2 = 0.08
# 论文 bar_upsilon_ai>0；代码按
# Upsilon_ai=(1/varrho_i+bar_upsilon_ai)I 构造实际 actor 耗散矩阵。
# 论文实验段同样没有给定数值，以下是需离线冻结的工程初值。
bar_upsilon_a1 = 0.70
bar_upsilon_a2 = 0.75
# actor 输出限幅，分别作用于 alpha 和第二层虚拟加速度中的学习补偿；
# 属于真机保护，不是论文理想近似器的权重界。
actor_limit1 = 0 0 0 0.10 0.10 0.10
actor_limit2 = 0 0 0 0.30 0.30 0.30
# false：与仿真一致，Actor 直接使用限幅后的 W^T*S；true：额外删除
# z^T*actor<0 的反向分量。论文对齐实验保持 false，真机调试可选择 true。
enable_actor_direction_projection = false
# actor 初始小斜率；critic 默认从 0 开始。若 enable_rl=false，这些初值
# 不进入控制输出；开启 RL 后先冻结学习观察其影响。实物 64 节点会在 CPP
# 中按仿真 25 节点乘 25/64，避免节点数增加放大初始策略。
initial_actor_gain1 = 0 0 0 0.005 0.005 0.005
initial_actor_gain2 = 0 0 0 0.005 0.005 0.005
# 与仿真相同的“小噪声+中心斜率”初始化；自定义固定种子生成器保证复现。
initial_weight_noise = 0.001
initial_weight_seed = 21

# 固定三轴网络输入：
# Z1_A=[z1_A,q_A,qd_A,qd_dot_A,beta,beta_dot]，4*3+2=14 维；
# Z2_A=[z2_A,q_A,dq_A,alpha_A,alpha_dot_A,phi]，5*3+1=16 维。
# 每层保留 64 个确定性 Halton 高维稀疏中心，前 25 个与仿真相同，后 39 个
# 沿同一序列续接。网络输出由两行扩为三行，不建立指数规模规则网格。
rbf_center_min = -1.5
rbf_center_max = 1.5
# CPP 分母是 width^2*dimension；1.02 对应 14/16 维有效宽度 3.82/4.08，
# 与仿真 10/11 维使用的 3.2/3.4 保持相近的每维核尺度。
rbf_width = 1.02
# z1、beta_dot、phi 的附加标准化尺度；其余分量复用边界/速度/alpha 限幅。
rbf_z1_scale = 0 0 0 0.3 0.3 0.3
rbf_beta_dot_scale = 0.5
rbf_phi_scale = 1.5
rbf_standardized_clip = 4.0

# -----------------------------------------------------------------------------
# 6. xMateCR7 URDF 质量矩阵与固定关节 4~6 子矩阵
# -----------------------------------------------------------------------------
# true：使用厂家 xMateCR7.urdf 的关节轴、连杆质量、质心和惯性在线计算
# 完整 6x6 M(q)，再固定提取第 4~6 行列形成 M_AA；false：使用下方对角回退。
use_xmate_cr7_urdf_mass_matrix = true
# 部分关节控制使用主子矩阵的必要实验假设。true 只是一份声明，CPP 无法靠
# 发送 0 Nm 锁住关节；必须由厂家允许的独立位置伺服、制动器或机械约束实现。
inactive_joints_fixed = true
# 厂家 URDF 自身标注“inertia in the model is not correct”，六组惯性主值
# 也均违反刚体惯量三角不等式。此项现在只记录是否已人工确认风险：
# false：真机启动时打印醒目警告，但程序继续运行；true：不打印该警告。
# 它不会关闭质量矩阵有限性/正定性检查，也不会关闭运行时安全停机。
acknowledge_unverified_urdf_inertia = false

# 仅 use_xmate_cr7_urdf_mass_matrix=false 时使用：
# tau=diag(nominal_inertia_diag)*v+torque_bias。它是安全回退而非论文完整 M(q)。
nominal_inertia_diag = 0 0 0 1.0 1.0 1.0
# 固定力矩偏置预留给经验证的补偿；默认 0，未知重力时不要凭感觉填写。
torque_bias = 0 0 0 0 0 0

# -----------------------------------------------------------------------------
# 7. 工程安全限制与日志
# -----------------------------------------------------------------------------
# 以下值是保守起点，不是厂家额定值；必须按具体机型/负载再次下调或确认。
# tau_limit：发送 SDK 前的逐轴绝对幅值上限；不是控制器理论饱和界。
tau_limit = 0 0 0 0 0.8 0
# tau_rate_limit：逐轴力矩变化率 Nm/s；1 ms 周期内最大步长=该值*0.001。
tau_rate_limit = 0 0 0 0 12 0
# |q-q_d| 超过 abort_error 或 |dq| 超过 abort_velocity 时，本周期命令置 0
# 并结束实时循环。检查覆盖全部六轴，包括固定但仍可能漂移的关节 1~3。
